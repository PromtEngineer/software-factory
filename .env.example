# Copy to .env and fill in. Never commit .env.

# Required: Upstash Box API key (console.upstash.com -> Box -> API Keys). Starts with box_
UPSTASH_BOX_API_KEY=

# Required: your copy of the tinylinks demo repo, as a full URL
FACTORY_REPO=https://github.com/<you>/tinylinks

# Required: fine-grained GitHub token for that repo only
# (Contents: read/write, Issues: read/write, Pull requests: read/write)
GITHUB_TOKEN=

# Optional: Context7 key for the docs tool (--grounding). Without it, Context7 Search works keyless at demo rate limits.
CONTEXT7_API_KEY=

# Optional: your own Anthropic API key. Without it, agents use Upstash's built-in model budget, which has a monthly cap.
FACTORY_LLM_KEY=
